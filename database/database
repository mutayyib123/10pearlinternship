-- =====================================================
-- Contact Management System - Database Setup
-- SQL Server Database Script
-- =====================================================

-- 1. DROP EXISTING DATABASE (Optional - Uncomment if needed)
-- DROP DATABASE IF EXISTS contact_management_db;

-- 2. CREATE DATABASE
CREATE DATABASE contact_management_db;
GO

-- 3. USE THE DATABASE
USE contact_management_db;
GO

-- =====================================================
-- 4. CREATE TABLES
-- =====================================================

-- Table: app_users
-- Description: Stores user information for the system
CREATE TABLE app_users (
    id BIGINT PRIMARY KEY IDENTITY(1,1),
    name NVARCHAR(100) NOT NULL,
    email NVARCHAR(150) NOT NULL UNIQUE,
    phone NVARCHAR(20) NOT NULL,
    password NVARCHAR(255) NOT NULL
);

-- Table: contacts
-- Description: Stores contact information linked to users
CREATE TABLE contacts (
    id BIGINT PRIMARY KEY IDENTITY(1,1),
    first_name NVARCHAR(100) NOT NULL,
    last_name NVARCHAR(100) NOT NULL,
    title NVARCHAR(100),
    user_id BIGINT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES app_users(id) ON DELETE CASCADE
);

-- Table: contact_details
-- Description: Stores detailed contact information (email, phone)
CREATE TABLE contact_details (
    id BIGINT PRIMARY KEY IDENTITY(1,1),
    contact_id BIGINT NOT NULL,
    type NVARCHAR(50) NOT NULL,           -- WORK, HOME, PERSONAL
    value NVARCHAR(150) NOT NULL,         -- Email or Phone Number
    category NVARCHAR(50) NOT NULL,       -- EMAIL or PHONE
    FOREIGN KEY (contact_id) REFERENCES contacts(id) ON DELETE CASCADE
);

-- =====================================================
-- 5. CREATE INDEXES (For Performance)
-- =====================================================

-- Index on user email (used for login)
CREATE INDEX idx_users_email ON app_users(email);

-- Index on contact user_id (used for fetching user contacts)
CREATE INDEX idx_contacts_user_id ON contacts(user_id);

-- Index on contact first/last name (used for search)
CREATE INDEX idx_contacts_name ON contacts(first_name, last_name);

-- Index on contact_details contact_id (used for fetching details)
CREATE INDEX idx_contact_details_contact_id ON contact_details(contact_id);

