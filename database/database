-- 7. VERIFY DATA
-- =====================================================

-- View all users
SELECT * FROM app_users;

-- View all contacts with user details
SELECT c.id, c.first_name, c.last_name, c.title, u.name AS user_name, u.email AS user_email
FROM contacts c
INNER JOIN app_users u ON c.user_id = u.id;

-- View all contact details
SELECT cd.id, cd.contact_id, cd.type, cd.value, cd.category, c.first_name, c.last_name
FROM contact_details cd
INNER JOIN contacts c ON cd.contact_id = c.id;

